{
  "as_of_date": "2026-11-14",
  "note": "All retention periods are TEST POLICIES for demonstration only – not legal requirements.",
  "rules": [
    {
      "dataset": "employees.csv",
      "trigger_column": "termination_date",
      "retention_years": 7,
      "description": "Employee records retained 7 years after termination"
    },
    {
      "dataset": "customers.csv",
      "trigger_column": "account_closed_date",
      "retention_years": 5,
      "description": "Customer records retained 5 years after account closure"
    },
    {
      "dataset": "suppliers.csv",
      "trigger_column": "contract_end_date",
      "retention_years": 7,
      "description": "Supplier records retained 7 years after contract end"
    },
    {
      "dataset": "support_tickets.csv",
      "trigger_column": "closed_date",
      "retention_years": 3,
      "description": "Support tickets retained 3 years after closure"
    },
    {
      "dataset": "marketing_contacts.csv",
      "trigger_column": "retention_trigger_date",
      "retention_years": 2,
      "description": "Marketing contacts retained 2 years after unsubscribe or last engagement"
    },
    {
      "dataset": "access_logs.csv",
      "trigger_column": "access_timestamp",
      "retention_years": 1,
      "description": "Access logs retained 1 year after the access event"
    }
  ],
  "hold_column": "on_hold",
  "hold_value": "Y",
  "invalid_date_values": ["", "invalid", "N/A", "unknown", "TBD", "pending", "NULL", "0000-00-00", "malformed", "ongoing", "TBC", "open", "invalid-date"]
}
